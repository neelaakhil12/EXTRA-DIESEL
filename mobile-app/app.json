    "userInterfaceStyle": "light",
    "scheme": "extradiesel",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.extradiesel.app"
    },
    "android": {
      "package": "com.extradiesel.app",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
