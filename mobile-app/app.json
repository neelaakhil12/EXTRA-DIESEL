{
  "expo": {
    "name": "Extra Diesel",
    "slug": "extra-diesel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "extradiesel",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.extradiesel.app"
    },
    "android": {
      "package": "com.extradiesel.app",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#D50000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withCleartextTraffic",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.818952981825-0rcecfahu2vqunp0pjc6ufep70oknq35"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Extra Diesel to use your location to deliver diesel directly to your bowser site."
        }
      ]
    ],
    "owner": "student17s-team",
    "extra": {
      "eas": {
        "projectId": "749f21ae-d79b-4f37-a73c-ff02ca48d039"
      }
    }
  }
}
