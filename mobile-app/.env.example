# Extra Diesel Mobile App - Environment Configuration Example

# Google OAuth Client IDs
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com

# Mapbox Access Token (Live GPS & Bowser Tracking)
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# Backend API Endpoints
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000
EXPO_PUBLIC_LIVE_API_BASE_URL=http://15.206.165.210
