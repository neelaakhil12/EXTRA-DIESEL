# Server Configuration
PORT=5000
NODE_ENV=production

# AWS Configuration (Asia Pacific Mumbai region: ap-south-1)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=extra-diesel-storage-ap-south-1

# Optional: If not using EC2 IAM Role, specify IAM User Access Keys
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Frontend CORS
FRONTEND_URL=https://extra-diesel.vercel.app
